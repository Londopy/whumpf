# Copy to web/.env

# Cesium ion token. https://cesium.com/ion/tokens
# Vite exposes VITE_* to the client, so scope this token to asset read only.
VITE_ION_TOKEN=

# Leave unset in dev; vite.config.js proxies /api to localhost:5000.
VITE_API_URL=

# XYZ template for real packed attribute tiles. Leave unset and the overlay is
# the synthetic cone in testTile.js -- a development shape, not terrain. The
# app says so on screen when this is unset; do not remove that badge.
#
# After: python -m pipeline.cli attributes --aoi <slug>
VITE_ATTRIBUTE_TILES=/api/tiles/{aoi}/attributes
