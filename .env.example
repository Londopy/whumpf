# Copy to .env and fill in. .env is gitignored -- never commit real keys.

# Cesium ion -- terrain hosting. Free tier 5 GB.
# https://cesium.com/ion/tokens
ION_TOKEN=

# LINZ Data Service -- NZ elevation and aerial imagery. Free account.
# https://data.linz.govt.nz/my/api/
LINZ_API_KEY=

# Cloudflare R2 -- static tile hosting
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=whumpf-tiles
R2_PUBLIC_URL=

# Microsoft Planetary Computer needs no key for anonymous asset access.
# NAIP and Sentinel-2 are both free.

# RevenueCat -- mobile only, not used by the pipeline or API.
# Public SDK keys are safe to ship in the client; the SECRET key is not.
REVENUECAT_IOS_KEY=
REVENUECAT_ANDROID_KEY=
